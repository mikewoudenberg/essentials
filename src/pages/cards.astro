---
import { getCollection } from 'astro:content';
import CardLayout from '../layouts/CardLayout.astro';
import Header from '../components/Header.astro';
import Crumbpath from '../components/Crumbpath.astro';
import { parseCardContent } from '../utils/cardParser';

const allCards = await getCollection('cards');

// Filter and sort cards
const validCategories = ['collaboration', 'craftsmanship', 'realisation', 'testing'];
const cards = allCards
  .filter(card => validCategories.includes(card.data.category))
  .map(card => {
    const parsed = parseCardContent(card.body);
    return {
      id: card.id,
      slug: card.id.replace(/\.md$/, ''),
      title: parsed.title,
      category: card.data.category,
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title));
---

<CardLayout title="Table of Contents - Xebia Essentials" description="List of all cards">
  <Crumbpath
    slot="crumbpath"
    items={[{ label: 'Home', to: '/' }, { label: 'Table of Contents' }]}
  />
  <Header title="Table of Contents" color="indigo" />
  <div class="prose p-6">
    <p>This is an alphabetical index of the cards in the Xebia Essentials deck.</p>
    <ul>
      {cards.map(card => (
        <li>
          <a href={`/${card.slug}`}>{card.title}</a>
        </li>
      ))}
    </ul>
  </div>
</CardLayout>
