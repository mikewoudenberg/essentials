---
import { getCollection } from 'astro:content';
import CardLayout from '../../layouts/CardLayout.astro';
import Header from '../../components/Header.astro';
import Crumbpath from '../../components/Crumbpath.astro';
import { parseCardContent } from '../../utils/cardParser';

export async function getStaticPaths() {
  const allCards = await getCollection('cards');

  // Get unique categories
  const categories = [...new Set(allCards.map(card => card.data.category))];

  return categories.map(category => ({
    params: { category },
    props: {
      category,
      cards: allCards.filter(card => card.data.category === category),
    },
  }));
}

const { category, cards } = Astro.props;

// Parse and sort cards by title
const parsedCards = cards
  .map(card => {
    const parsed = parseCardContent(card.body);
    return {
      id: card.id,
      slug: card.id.replace(/\.md$/, ''),
      title: parsed.title,
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title));

const categoryTitle = category.charAt(0).toUpperCase() + category.slice(1);
---

<CardLayout
  title={`${categoryTitle} - Xebia Essentials`}
  description={`List of all cards in category ${categoryTitle}`}
>
  <Crumbpath
    slot="crumbpath"
    items={[{ label: 'Home', to: '/' }, { label: categoryTitle }]}
  />
  <Header title={categoryTitle} color="indigo" />
  <div class="prose p-6">
    <ul>
      {parsedCards.map(card => (
        <li>
          <a href={`/${card.slug}`}>{card.title}</a>
        </li>
      ))}
    </ul>
  </div>
</CardLayout>
